# Example remote backend. Do not pass this file to terraform init until an
# approved AWS plan has created the bucket and lock table.
#
#   terraform init -backend-config=../../envs/sandbox/backend.hcl.example
#
# This file is documentation. The lab root uses a local backend and a plan-time
# guard that refuses apply.

bucket         = "portfolio-tfstate-example"
key            = "lab/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "portfolio-tfstate-lock"
encrypt        = true
