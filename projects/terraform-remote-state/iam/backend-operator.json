{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListExampleStateKeys",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::EXAMPLE_STATE_BUCKET",
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "env/dev/terraform.tfstate",
            "env/sit/terraform.tfstate",
            "env/uat/terraform.tfstate",
            "env/prod/terraform.tfstate"
          ]
        }
      }
    },
    {
      "Sid": "ReadWriteExampleStateObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::EXAMPLE_STATE_BUCKET/env/dev/terraform.tfstate",
        "arn:aws:s3:::EXAMPLE_STATE_BUCKET/env/sit/terraform.tfstate",
        "arn:aws:s3:::EXAMPLE_STATE_BUCKET/env/uat/terraform.tfstate",
        "arn:aws:s3:::EXAMPLE_STATE_BUCKET/env/prod/terraform.tfstate"
      ]
    },
    {
      "Sid": "DescribeLockTable",
      "Effect": "Allow",
      "Action": "dynamodb:DescribeTable",
      "Resource": "arn:aws:dynamodb:EXAMPLE_REGION:EXAMPLE_ACCOUNT_ID:table/EXAMPLE_LOCK_TABLE"
    },
    {
      "Sid": "LockAndDigestItems",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:EXAMPLE_REGION:EXAMPLE_ACCOUNT_ID:table/EXAMPLE_LOCK_TABLE",
      "Condition": {
        "ForAllValues:StringEquals": {
          "dynamodb:LeadingKeys": [
            "EXAMPLE_STATE_BUCKET/env/dev/terraform.tfstate",
            "EXAMPLE_STATE_BUCKET/env/dev/terraform.tfstate-md5",
            "EXAMPLE_STATE_BUCKET/env/sit/terraform.tfstate",
            "EXAMPLE_STATE_BUCKET/env/sit/terraform.tfstate-md5",
            "EXAMPLE_STATE_BUCKET/env/uat/terraform.tfstate",
            "EXAMPLE_STATE_BUCKET/env/uat/terraform.tfstate-md5",
            "EXAMPLE_STATE_BUCKET/env/prod/terraform.tfstate",
            "EXAMPLE_STATE_BUCKET/env/prod/terraform.tfstate-md5"
          ]
        },
        "Null": {
          "dynamodb:LeadingKeys": "false"
        }
      }
    }
  ]
}
