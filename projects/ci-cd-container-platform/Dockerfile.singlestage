# Intentionally inefficient control image for size comparison demos.
# Uses the full Python image (not slim) and keeps pip cache — a common anti-pattern.
FROM python:3.12
WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY app ./app
COPY configs ./configs
EXPOSE 8080
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
