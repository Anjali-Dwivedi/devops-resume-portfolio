%%{init: {"flowchart": {"htmlLabels": true, "curve": "basis"}}}%%
flowchart TB
  subgraph Trust["Trust boundaries"]
    DEV[Developer laptop]
    CI[CI runner · OIDC]
    CLOUD[Cloud account]
    CLUSTER[Kubernetes cluster]
  end

  subgraph Identity["Identity & access"]
    OIDC[GitHub OIDC → AWS role]
    IAM[Least-privilege IAM policies<br/>no * on iam:PassRole]
    IRSA[Pod identity / IRSA pattern]
    RBAC[K8s RBAC · deploy SA only]
  end

  subgraph Secrets["Secrets"]
    SM[Secrets Manager / sealed pattern]
    NOGIT[Never commit secrets<br/>.gitignore enforced]
  end

  subgraph Threats["Threats addressed in demos"]
    T1[Stolen long-lived cloud key]
    T2[Privileged container]
    T3[Public state bucket]
    T4[Config drift to prod sqlite]
  end

  DEV --> CI
  CI --> OIDC --> IAM --> CLOUD
  CLOUD --> IRSA --> CLUSTER
  CLUSTER --> RBAC
  SM --> CLUSTER
  NOGIT --> CI

  T1 -.->|mitigated by| OIDC
  T2 -.->|mitigated by| RBAC
  T3 -.->|mitigated by| IAM
  T4 -.->|mitigated by| CI

  classDef trust fill:#E8F1F5,stroke:#1F6F8B,color:#0B1F2A
  classDef id fill:#0B3D5C,stroke:#1F6F8B,color:#F4F7FA
  classDef threat fill:#8B1E3F,stroke:#5C0F28,color:#F4F7FA
  class DEV,CI,CLOUD,CLUSTER trust
  class OIDC,IAM,IRSA,RBAC,SM,NOGIT id
  class T1,T2,T3,T4 threat
