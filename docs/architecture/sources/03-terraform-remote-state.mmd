%%{init: {"flowchart": {"htmlLabels": true, "curve": "basis"}}}%%
flowchart TB
  subgraph Teams["Concurrent engineering teams"]
    T1[Team A · terraform apply]
    T2[Team B · terraform apply]
  end

  subgraph Control["State control plane"]
    INIT[terraform init]
    LOCK[DynamoDB lock table<br/>LockID conditional write]
    STATE[S3 state bucket<br/>versioning · SSE · block public]
  end

  subgraph Modules["Reusable modules"]
    VPC[network module]
    IAM[IAM least-privilege module]
    EKS[EKS/node stubs · optional]
  end

  subgraph Safety["Safety rails"]
    PLAN[terraform plan · reviewed]
    POLICY[Policy checks<br/>no wildcard IAM]
    APPLY[apply only after approval]
  end

  T1 --> INIT
  T2 --> INIT
  INIT --> LOCK
  LOCK -->|acquire| STATE
  STATE --> PLAN --> POLICY --> APPLY
  APPLY --> VPC
  APPLY --> IAM
  APPLY --> EKS
  APPLY -->|release| LOCK

  classDef actor fill:#E8F1F5,stroke:#1F6F8B,color:#0B1F2A
  classDef core fill:#0B3D5C,stroke:#1F6F8B,color:#F4F7FA
  classDef safe fill:#F7B538,stroke:#C9921A,color:#0B1F2A
  class T1,T2,VPC,IAM,EKS actor
  class INIT,LOCK,STATE core
  class PLAN,POLICY,APPLY safe
